<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="900dp"
                android:centerX="0.5" android:centerY="0.42"
                android:startColor="#166534"
                android:endColor="#0B3D1F" />
        </shape>
    </item>
    <!-- الشعار في المنتصف (يظهر لحظة الإطلاق قبل تحميل WebView) -->
    <item android:gravity="center" android:width="130dp" android:height="130dp">
        <bitmap android:src="@drawable/splash_logo" android:gravity="center" />
    </item>
</layer-list>
